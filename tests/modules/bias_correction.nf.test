nextflow_process {

    name "Test Process BIAS_CORRECTION"
    script "modules/bias_correction.nf"
    process "BIAS_CORRECTION"

    // Define parameters required by the R script template
    setup {
        params {
            crispr_lib = "KY_Library_v1.0" // CRISPR library name
            min_reads = 30 // Minimum reads for a sgRNA to be included in bias correction
            n_controls = 1 // Number of control sgRNAs required for bias correction
            scaling_method = "ScalingByTotalReads" // Method for scaling read counts
            min_treatments = 2 // Minimum number of treatment samples required for bias correction
            default_n_cols_sgrna = 2 // Default number of columns in the input file before treatment samples
            lfc_corr_dir = "results/bias_correction" // Directory for bias correction results
        }
    }

    test("Should perform bias correction with treatments >= min_treatments") {
        when {
            process {
                // Provide a file with at least 2 treatment columns 
                // (which meets the min_treatments requirement)
                """
                input[0] = ["batch_1", file("${projectDir}/tests/data/sufficient_treatments.tsv")]
                """
            }
        }

        then {
            assert process.success
            assert process.out.lfc_corr.size() == 1
            assert process.out.skipped_cell_line.size() == 0
        }
    }

    test("Should skip bias correction if treatments < min_treatments") {
        when {
            process {
                // Provide a file with only 1 treatment columns 
                // (which does not meet the min_treatments requirement)
                """
                input[0] = ["batch_1", file("${projectDir}/tests/data/low_n_treatments.tsv")]
                """
            }
        }

        then {
            assert process.success

            // The LFC output should not exist 
            assert process.out.lfc_corr.size() == 0
            
            // The skip log should be emitted 
            assert process.out.skipped_cell_line.size() == 1
            assert path(process.out.skipped_cell_line[0]).text.contains("low_n_treatments")
        }
    }

    test("Should fail if an unsupported CRISPR library is provided") {
        when {
            params {
                crispr_lib = "Unsupported_Library"
            }
            process {
                // Provide a file with sufficient treatments to ensure the failure is 
                // due to the unsupported library
                """
                input[0] = ["batch_1", file("${projectDir}/tests/data/sufficient_treatments.tsv")]
                """
            }
        }
        then {
            // Assert that the process execution failed
            assert process.failed
            
            // Assert that the error is related to the R script being unable to find the data
            assert process.errorReport.contains("Object 'Unsupported_Library' not found") || 
                process.errorReport.contains("data set 'Unsupported_Library' not found")
        }
    }
}
