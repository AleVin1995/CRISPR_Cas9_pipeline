nextflow_process {

    name "Test Process RUN_MAGECK"
    script "modules/run_mageck.nf"
    process "RUN_MAGECK"

    test("Should validate MAGeCK input format and design matrix structure") {
        when {
            params {
                mageck_dir = "results/mageck" // Output directory for MAGeCK results
                default_n_cols_sgrna = 2 // Default number of columns for sgRNA identifiers in the input count matrix
                min_treatments = 1 // Minimum number of treatment samples required for MAGeCK MLE
                n_controls = 1 // Minimum number of control samples required for MAGeCK MLE
                mageck_col = "fdr" // Column to keep in the gene summary output
            }
            process {
                """
                // Load all batch files from the directory
                // Mapping each file to [ batch_name, file ]
                input[0] = channel.fromPath("${projectDir}/tests/data/mageck_batches/mageck1.tsv.gz")
                    .map { it -> [ it.simpleName, it ] }
                
                input[1] = file("${projectDir}/modules/templates/design_matrix_mageck.R")
                """
            }
        }

        then {
            assertAll(
                // Check overall success
                { assert process.success },

                // Check Input File Format after gunzip 
                {
                    def unzippedFile = path(process.out.mageck[0]).parent.resolve("mageck1.tsv")

                    if (unzippedFile.exists()) {
                        def lines = unzippedFile.readLines()
                        def header = lines[0].split('\t')
                        
                        assert header.size() >= 4 : "MAGeCK count matrix must have at least 4 columns"
                        assert header[0] == "sgRNA" : "First column must be sgRNA"
                    }
                },

                // Check design matrix format
                {
                    def designMatrix = path(process.out.mageck[0]).parent.resolve("mageck1_design_matrix.tsv")
                    assert designMatrix.exists()

                    def lines = designMatrix.readLines()
                    def header = lines[0].split('\t')
                    
                    assert header[0] == "samples" : "Design matrix must start with 'samples' column"
                    assert header[1] == "baseline" : "Second column must be 'baseline'"
                    assert header[2].endsWith("_cell_line") : "Third column must follow the naming convention '<treatment>_cell_line'"
                    
                    // Verify binary indicators for MAGeCK MLE 
                    def row1 = lines[1].split('\t')
                    assert row1[1] == "1" : "Baseline must be 1"
                    assert (row1[2] == "0" || row1[2] == "1") : "Treatment indicator must be binary"
                }
            )
        }
    }
}
