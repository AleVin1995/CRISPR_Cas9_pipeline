nextflow_process {

    name "Test Process AVERAGE_MATRIX"
    script "modules/average_matrix.nf"
    process "AVERAGE_MATRIX"

    test("Should average numeric columns by gene") {
        setup {
            params {
                avg_col = "genes"
                lfc_gene_qc = "averaged_gene_matrix.tsv"
                outdir = "results"
            }
        }

        when {
            process {
                // Provide a mock TSV where Gene A has two sgRNAs with LFCs 2 and 4
                // and Gene B has two sgRNAs with LFCs -1 and -3, so the average for 
                // Gene A should be 3 and for Gene B should be -2
                """
                input[0] = file("${projectDir}/tests/data/matrix_to_average.tsv")
                """
            }
        }

        then {
            assert process.success
            assert process.out.lfc_gene_qc.size() == 1
            
            def result = path(process.out.lfc_gene_qc[0]).readLines()
            def header = result[0].split("\t")
            def first_row = result[1].split("\t")
            def second_row = result[2].split("\t")

            // Find index of the averaged column (e.g., sample_lfc)
            int col_idx = header.findIndexOf { it == "sample_lfc" }
            
            // Assert that (2.0 + 4.0) / 2 = 3.0
            assert Double.parseDouble(first_row[col_idx]) == 3.0

            // Assert that (-1.0 + -3.0) / 2 = -2.0
            assert Double.parseDouble(second_row[col_idx]) == -2.0

            // Assert that the gene names are preserved
            assert first_row[0] == "GENE_A"
            assert second_row[0] == "GENE_B"

            // Check header does not contain the original sgRNA column and contains the averaged column
            assert !header.contains("sgRNA")
            assert header.contains("sample_lfc")
        }
    }
}
