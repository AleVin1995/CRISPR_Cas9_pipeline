nextflow_process {

    name "Test Process ASSEMBLE_MATRIX"
    script "modules/assemble_matrix.nf"
    process "ASSEMBLE_MATRIX"

    test("Should join multiple LFC files into a single matrix") {
        when {
            process {
                // Input 1: A list of files (Nextflow 'path' handles lists)
                // Input 2: Output filename
                // Input 3: Columns to join on (must be a list)
                // Input 4: Columns to drop (must be a list)
                """
                input[0] = [
                    file("${projectDir}/tests/data/sample1_lfc_corr_qc.tsv"),
                    file("${projectDir}/tests/data/sample2_lfc_corr_qc.tsv")
                ]
                input[1] = "merged_matrix.tsv"
                input[2] = ["sgRNA", "genes"]
                input[3] = ["CHR", "startp", "endp", "avgFC", "BP", "correction", "guideIdx"]
                """
            }
        }

        then {
            assert process.success
            assert process.out.matrix_all.size() == 1
            
            // Load the output file to check content
            def matrix = path(process.out.matrix_all[0]).readLines()
            def header = matrix[0].split("\t")
            
            // Assertions on the resulting columns
            assert header.contains("sample1_lfc")
            assert header.contains("sample2_lfc")

            assert !header.contains("CHR")
            assert !header.contains("startp")
            assert !header.contains("endp")
            assert !header.contains("avgFC")
            assert !header.contains("BP")
            assert !header.contains("correction")
            assert !header.contains("guideIdx")
            
            // Assert row count (excluding header) matches expected join result
            assert matrix.size() > 1
        }
    }
}
