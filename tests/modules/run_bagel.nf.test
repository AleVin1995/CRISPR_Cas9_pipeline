nextflow_process {

    name "Test Process RUN_BAGEL"
    script "modules/run_bagel.nf"
    process "RUN_BAGEL"

    test("Should run BAGEL python script and generate .bf output") {
        when {
            params {
                bagel_sgrna_col = "sgRNA" // Column name for sgRNA identifiers in the input file
                bagel_gene_col = "genes" // Column name for gene identifiers in the input file
                bagel_val_col = "bagel_test1_lfc" // Column name for log fold change values in the input file
                bagel_n_cross_validations = 2 // Number of cross-validations for BAGEL
                ctrl_gene_col = "GENE" // Column name for gene identifiers in control files (positive and negative)
            }
            process {
                """
                // Define input files
                input[0] = file("${projectDir}/tests/data/bagel_test1.tsv")
                input[1] = file("${projectDir}/bagel/BAGEL.py")
                input[2] = file("${projectDir}/tests/data/pos_ctrls.txt")
                input[3] = file("${projectDir}/tests/data/neg_ctrls.txt")
                """
            }
        }

        then {
            assert process.success

            // Ensure the input file has the expected format
            def bf_lines = file("${projectDir}/tests/data/bagel_test1.tsv").readLines()
            def bf_header = bf_lines[0].split('\t')

            int bf_sgrnaIdx = bf_header.findIndexOf { it == params.bagel_sgrna_col }
            int bf_geneIdx  = bf_header.findIndexOf { it == params.bagel_gene_col }
            int bf_lfcIdx   = bf_header.findIndexOf { it == params.bagel_val_col }

            def bf_input_sgRNAs = bf_lines.drop(1).collect { it.split('\t')[bf_sgrnaIdx] }.toSet()
            def bf_input_genes = bf_lines.drop(1).collect { it.split('\t')[bf_geneIdx] }.toSet()
            def bf_input_lfc = bf_lines.drop(1).collect { it.split('\t')[bf_lfcIdx] }.toSet()

            // Closure to validate control files
            def validateControlFile = { fileObj ->
                def lines = fileObj.readLines()
                def header = lines[0].split('\t')
                int geneIdx = header.findIndexOf { it == params.ctrl_gene_col }
                
                // Assert the header "GENE" exists
                assert geneIdx != -1 : "Column '${params.ctrl_gene_col}' not found in ${fileObj.name}"
                
                // Collect genes from this control file
                def ctrlGenes = lines.drop(1).collect { it.split('\t')[geneIdx] }

                // Assert at least 1 gene is present in the control file
                assert ctrlGenes.size() > 0 : "No genes found in control file ${fileObj.name}"

                // Assert all control genes are strings
                assert ctrlGenes.every { it instanceof String } : "Not all genes in ${fileObj.name} are strings"
                
                // Assert at least 1 gene overlap with input data
                def hasOverlap = ctrlGenes.any { it in bf_input_genes }
                assert hasOverlap : "No overlapping genes found between ${fileObj.name} and input data"
                
                return true
            }

            // Check if the process completed successfully
            assertAll(
                { assert process.success },
                
                // Verify output file emission (if the mock script were to actually create it)
                { assert process.out.bagel != null },

                // Test the content of the input file assigned to the process 
                {
                    // Verify sgRNA column exists and contains only strings 
                    assert bf_header.contains(params.bagel_sgrna_col)
                    assert bf_input_sgRNAs.every { it instanceof String }

                    // Verify Gene column exists and contains only strings 
                    assert bf_header.contains(params.bagel_gene_col)
                    assert bf_input_genes.every { it instanceof String }

                    // Verify LFC column exists and contains float-compatible values
                    assert bf_header.contains(params.bagel_val_col)
                    assert bf_input_lfc.every { it.isDouble() } // Matches integers, 
                    // floats, and scientific notation
                },

                // Test the content of the positive and negative control files 
                {
                    assert validateControlFile(file("${projectDir}/tests/data/pos_ctrls.txt"))
                    assert validateControlFile(file("${projectDir}/tests/data/neg_ctrls.txt"))
                }
            )
        }
    }

}
