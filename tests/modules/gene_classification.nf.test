nextflow_process {

    name "Test Process GENE_CLASSIFICATION"
    script "modules/gene_classification.nf"
    process "GENE_CLASSIFICATION"

    test("Should classify genes into core, context, and non-essential categories") {
        setup {
            params {
                gene_class = "classified_genes.tsv"
                outdir = "results"
            }
        }

        when {
            process {
                // Input 1: Gene-level LFC matrix
                // Input 2: Positive control list
                // Input 3: Negative control list
                """
                input[0] = file("${projectDir}/tests/data/gene_lfc_matrix.tsv")
                input[1] = file("${projectDir}/tests/data/pos_ctrls.txt")
                input[2] = file("${projectDir}/tests/data/neg_ctrls.txt")
                """
            }
        }

        then {
            assert process.success
            assert process.out.gene_class.size() == 1
            
            // Check that the header is correct
            def result = path(process.out.gene_class[0]).readLines()
            assert result[0] == "gene\ttype"
            
            // Check that all expected types are present in the output
            def types = result.collect { it.split("\t")[1] }.unique()
            assert types.contains("core")
            assert types.contains("context")
            assert types.contains("noness")
        }
    }
}
