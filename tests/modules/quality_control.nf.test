nextflow_process {

    name "Test Process QUALITY_CONTROL"
    script "modules/quality_control.nf"
    process "QUALITY_CONTROL"

    // Define parameters required by the R script template
    setup {
        params {
            auroc_thr = 0.8
            crispr_lib = "KY_Library_v1.0" // CRISPR library name
            fdr = 0.05
            lfc_corr_qc_dir = "qc_results"
        }
    }

    test("Should pass QC when AUROC is above threshold") {
        when {
            process {
                // Input 1: LFC file, Input 2: Pos controls, Input 3: Neg controls
                """
                input[0] = file("${projectDir}/tests/data/sample_qc_lfc_corr.tsv")
                input[1] = file("${projectDir}/tests/data/pos_ctrls.txt")
                input[2] = file("${projectDir}/tests/data/neg_ctrls.txt")
                """
            }
        }

        then {
            assert process.success

            // Assert that the QC passed file was emitted 
            assert process.out.lfc_corr_qc != null
            assert process.out.lfc_corr_qc.size() == 1

            // Assert the log for failed samples was NOT created 
            assert process.out.low_qc_samples.size() == 0
            
            // Check file naming convention
            assert path(process.out.lfc_corr_qc[0]).fileName.toString().endsWith("_lfc_corr_qc.tsv")
        }
    }

    test("Should fail QC and emit log file when AUROC is below threshold") {
        when {
            params {
                auroc_thr = 0.99 // Set a high threshold to force QC failure
            }
            process {
                // Input 1: LFC file, Input 2: Pos controls, Input 3: Neg controls
                """
                input[0] = file("${projectDir}/tests/data/sample_qc_lfc_corr.tsv")
                input[1] = file("${projectDir}/tests/data/pos_ctrls.txt")
                input[2] = file("${projectDir}/tests/data/neg_ctrls.txt")
                """
            }
        }

        then {
            assert process.success

            // Assert that the QC passed file was emitted 
            assert process.out.lfc_corr_qc.size() == 0

            // Assert the log for failed samples was created
            assert process.out.low_qc_samples != null
            assert process.out.low_qc_samples.size() == 1
            
            // Check file naming convention
            assert path(process.out.low_qc_samples[0]).text.contains("sample_qc")
            assert path(process.out.low_qc_samples[0]).fileName.toString() == "low_qc_samples.log"
        }
    }

    // test("Should fail if multiple _lfc columns are present") {
    //     when {
    //         process {
    //             input[0] = file("${projectDir}/tests/data/multi_lfc_columns.tsv")
    //             input[1] = file("${projectDir}/tests/data/pos_ctrls.txt")
    //             input[2] = file("${projectDir}/tests/data/neg_ctrls.txt")
    //         }
    //     }

    //     then {
    //         assert process.failed
    //         assert process.errorReport.contains("Expected exactly one _lfc column")
    //     }
    // }
}
