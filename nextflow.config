params {
    avg_col = "genes"
    crispr_lib = "KY_Library_v1.0"
    default_n_cols_sgrna = 2
    drop_cols = ["sgRNA", "CHR", "startp", "endp", "BP"]
    gene_norm_lfc_assembled = "gene_norm_lfc_assembled.tsv"
    input_batches = "data/raw_sgrnas_counts_test/*"
    min_reads = 30
    min_treatments = 2
    n_controls = 1
    norm_counts_dir = "results/norm_counts"
    norm_lfc_dir = "results/norm_lfc"
    outdir = "results/"
    scaling_method = "ScalingByTotalReads"
    sgrna_norm_lfc_assembled = "sgrna_norm_lfc_assembled.tsv"
}