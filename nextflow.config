params {
    // Global
    input_batches = "data/raw_sgrnas_counts_test/*"
    outdir = "results/"
    log_dir = "log"
    crispr_lib = "KY_Library_v1.0"
    bagel_script = "bagel/BAGEL.py"
    pos_ctrl_genes = "bagel/CEGv2.txt"
    neg_ctrl_genes = "bagel/NEGv1.txt"
    design_matrix_mageck_script = "modules/templates/design_matrix_mageck.R"
    default_n_cols_sgrna = 2
    min_treatments = 2
    n_controls = 1

    // BIAS_CORRECTION
    lfc_corr_dir = "results/lfc_corr"
    min_reads = 30
    scaling_method = "ScalingByTotalReads"

    // QUALITY_CONTROL
    lfc_corr_qc_dir = "results/lfc_corr_qc"
    auroc_thr = 0.8
    fdr = 0.05

    // ASSEMBLE_MATRIX (LFC)
    lfc_sgrna_all = "lfc_sgrna_all.tsv"
    join_col_lfc = ["sgRNA", "genes"]
    drop_col_lfc = ["CHR", "startp", "endp", "avgFC", "BP", "correction", "guideIdx"]

    // AVERAGE_MATRIX
    avg_col = "genes"
    lfc_gene_qc = "lfc_gene_all.tsv"

    // GENE_CLASSIFICATION
    gene_class = "gene_classification.tsv"

    // RUN_BAGEL
    bagel_run = true
    bagel_dir = "results/bagel"
    bagel_sgrna_col = "sgRNA" // can be column name or position (python starts from 0)
    bagel_gene_col = "genes" // can be column name or position (python starts from 0)
    bagel_val_col = 8 // can be column name or position (python starts from 0)
    bagel_n_cross_validations = 10
    bf_gene_all = "bf_gene_all.tsv"
    join_col_bf = ["GENE"]
    drop_col_bf = []

    // RUN_MAGECK
    mageck_run = true
    mageck_dir = "results/mageck"
    mageck_col = "fdr"
    mageck_gene_all = "mageck_gene_all.tsv"
    join_col_mageck = ["Gene"]
    drop_col_mageck = []

    // Unused / legacy
    count_norm_dir = "results/count_norm"
}

process {
    container = 'crispr_cas9_pipeline:v1.0'
    
    withName: 'RUN_MAGECK' {
        maxForks = 1
    }
}

profiles {
    standard {
        process.executor = 'local'
    }
    
    cluster {
        process.executor = 'slurm'
        process.queue = 'long'
    }
    
    docker {
        docker.enabled = true
    }
}